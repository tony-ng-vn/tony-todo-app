{
  "name": "todo-day-summary",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:dependencies": "npm audit --audit-level=high",
    "check:node-toolchain": "node scripts/check-node-toolchain.mjs",
    "check:contribution-policy": "node scripts/check-contribution-policy.mjs",
    "check:swift-toolchain": "node scripts/check-swift-toolchain.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "setup:hooks": "node scripts/install-git-hooks.mjs",
    "test": "vitest run",
    "test:native-menubar": "swift test --package-path native",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:ui:note-caret": "node scripts/note-caret-smoke.mjs",
    "test:menubar": "node scripts/menubar-smoke.mjs",
    "build": "vite build",
    "build:native-menubar": "swift build --package-path native -c release",
    "dev": "vite dev --host 127.0.0.1",
    "menubar": "bash scripts/run-menubar-app.sh",
    "menubar:dev": "DONE_LOG_MENUBAR_URL=http://127.0.0.1:5176/menubar?local=1 bash scripts/run-menubar-app.sh",
    "menubar:check": "DONE_LOG_MENUBAR_URL=http://127.0.0.1:5176/menubar?local=1 MENUBAR_NATIVE_SMOKE=1 bash scripts/run-menubar-app.sh",
    "menubar:bundle": "bash scripts/build-menubar-app.sh",
    "menubar:install": "bash scripts/install-menubar-app.sh",
    "ci:replay": "node scripts/ci-replay.mjs",
    "ci:repair": "node scripts/ci-repair.mjs",
    "ci:promote": "node scripts/ci-promote-lesson.mjs",
    "ci:selftest-packet": "node scripts/ci-selftest-packet.mjs",
    "verify:web": "node scripts/ci-verify.mjs --scope web",
    "verify:native": "node scripts/ci-verify.mjs --scope native",
    "verify": "node scripts/ci-verify.mjs --scope all",
    "verify:push": "node scripts/ci-verify.mjs --scope all --mode push",
    "verify:push:web": "node scripts/ci-verify.mjs --scope web --mode push",
    "understanding:build": "node scripts/understanding-workbook.mjs",
    "understanding:serve": "node scripts/understanding-workbook.mjs && node scripts/understanding-serve.mjs",
    "bundle:agent-todos": "node scripts/inline-agent-todos.mjs",
    "bundle:agent-todos:check": "node scripts/inline-agent-todos.mjs --check"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "playwright": "^1.62.1",
    "svelte": "^5.56.8",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@insforge/sdk": "^1.5.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "feedback-sdk-widget": "^0.3.0",
    "lottie-web": "^5.13.0",
    "suncalc": "^2.0.1"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
